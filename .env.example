# Environment variable examples for native startup.
# Docker Compose overrides the host and database paths inside the container.
TALENT_RADAR_HOST=127.0.0.1
TALENT_RADAR_PORT=8765
TALENT_RADAR_DB=./data/talent_radar.db

# Optional: raises GitHub public API limits. Never commit a real token.
GITHUB_TOKEN=

# Optional local semantic matching. The application never sends candidate data
# to a cloud model and only accepts local or Docker-host Ollama addresses.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Compose uses this address to reach Ollama on the host computer.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
